# 仅作进程环境变量示例；程序不会自动读取 .env 文件。不要提交真实密钥。
# 用户目标在每次调用时传入；下面只列出运行配置。
MINIMUM_SW_AGENT_MODEL_PROVIDER=openai
MINIMUM_SW_AGENT_MODEL=填写模型名称
MINIMUM_SW_AGENT_API_KEY=填写真实密钥

# 以下项目可选，未设置时使用当前目录、20 轮和 30 秒。
# MINIMUM_SW_AGENT_WORKDIR=.
# MINIMUM_SW_AGENT_MAX_ROUNDS=20
# MINIMUM_SW_AGENT_TOOL_TIMEOUT_SECONDS=30
